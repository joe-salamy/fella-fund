[Unit]
Description=Fella Fund daily: refresh prices, rebuild and publish the site
Documentation=file://%h/Code/fella-fund/README.md
OnFailure=fella-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/Code/fella-fund
ExecStart=/home/joesa/.local/bin/uv run --frozen fella daily
Nice=10
TimeoutStartSec=20min
